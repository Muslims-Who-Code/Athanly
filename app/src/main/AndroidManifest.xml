<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required on API 33+ to show Athan/reminder notifications; requested at runtime on the onboarding Notifications screen -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Needed to call the Athan prayer-times API over Ktor -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Normal permission, granted automatically at install — lets ConnectivityProviderImpl
         check NetworkCapabilities so the Qibla screen can tell an offline state apart from
         a GPS-fix timeout, instead of treating both as the same generic error -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Coarse is enough for prayer-time calculation accuracy; fine is requested alongside it
         since FusedLocationProviderClient returns a better fix when both are granted. Requested
         at runtime on the onboarding Location screen -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- User-grantable special permission (API 31+) needed to schedule exact prayer-time alarms;
         AlarmSchedulerImpl checks canScheduleExactAlarms() and falls back to inexact if not granted -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Lets BootCompletedReceiver re-enqueue the sync worker after a device reboot, since
         AlarmManager alarms don't survive a reboot on their own -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".AthanlyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Athanly">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Athanly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported — only AlarmManager (same app, via the PendingIntent AlarmSchedulerImpl
             built) ever needs to deliver this broadcast -->
        <receiver
            android:name=".notifications.worker.PrayerNotificationReceiver"
            android:exported="false" />

        <!-- Exported=true is required for the system to deliver an implicit BOOT_COMPLETED
             broadcast; the intent-filter restricts it to only that one action -->
        <receiver
            android:name=".notifications.worker.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager's default androidx-startup initializer is removed because
             AthanlyApplication implements Configuration.Provider to supply HiltWorkerFactory
             instead, so WorkManager self-initializes with Hilt-injected workers -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>